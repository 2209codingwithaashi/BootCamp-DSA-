#include<iostream>
using namespace std;
int main(){
   int n , arr[50];
cout<<"Enter the size : ";
cin>>n;
cout<<"Enter the Elements : ";
for(int i = 0; i<n ; i++){
   cin>>arr[i];
}
int smallest = arr[0];
int pos = 0;
for ( int i = 1; i<n ; i++)
{
  if(arr[i] < smallest){
    smallest = arr[i];
    pos = i;
   }
}
for(int i = pos ; i < n-1 ; i++)
{
  arr[i] = arr[i+1];
}
n--;
cout<<"Array after deleting smallest element : ";
for(int i=0 ; i<n; i++){
cout<<arr[i]<<" "<<endl;
}
return 0;
}
